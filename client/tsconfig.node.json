{
  // TypeScript 컴파일러의 동작을 정하는 설정 묶음입니다.
  "compilerOptions": {
    // 이 설정을 다른 TypeScript 프로젝트에서 참조할 수 있게 합니다.
    "composite": true,
    // 외부 라이브러리의 타입 오류는 검사하지 않습니다.
    "skipLibCheck": true,
    // Vite가 처리할 ES 모듈 방식을 사용합니다.
    "module": "ESNext",
    // Vite 번들러에 맞는 방식으로 import 파일을 찾습니다.
    "moduleResolution": "bundler",
    // 기본 내보내기 방식이 다른 라이브러리도 편하게 가져올 수 있게 합니다.
    "allowSyntheticDefaultImports": true
  },
  // Vite 설정 파일만 이 설정으로 검사합니다.
  "include": ["vite.config.ts"]
}
