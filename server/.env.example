# 백엔드 API 서버가 실행될 포트 번호입니다.
PORT=4000

# 이 주소에서 열린 React 화면의 요청만 서버가 허용합니다.
CLIENT_ORIGIN=http://localhost:5173

# LA 같은 도시 약어를 올바른 장소로 해석할 OpenAI API 키입니다.
# 실제 키는 .env에만 넣고 GitHub에는 절대 올리지 않습니다.
OPENAI_API_KEY=

# 선택 사항: 사용할 OpenAI 모델입니다. 비워 두면 gpt-4o-mini를 사용합니다.
OPENAI_MODEL=gpt-4o-mini

# Open-Meteo는 API 키가 필요 없는 무료 공개 API라 별도 키 설정이 필요 없습니다.
